<UserControl x:Class="MetalMonitor.UI.Views.DeviceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="200">
    
    <!-- 根 Grid，命名为 RootGrid，后台代码会设置它的 DataContext -->
    <Grid x:Name="RootGrid" Cursor="Hand">
        <Border CornerRadius="8" 
                Width="200" Padding="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FF2D2D3F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Device.IsAlarming}" Value="True">
                            <Setter Property="Background" Value="#FF4A3535"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- 设备名称，现在绑定到 ViewModel 的 Device.Name -->
                <TextBlock Text="{Binding Device.Name}" 
                           FontSize="16" Foreground="White" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                
                <!-- 温度数字和曲线放在一起 -->
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="60"/> <!-- 曲线高度 -->
                    </Grid.RowDefinitions>

                    <!-- 温度数值 -->
                    <TextBlock Grid.Row="0" FontSize="28" Foreground="LightGreen" 
                               HorizontalAlignment="Center">
                        <Run Text="{Binding Device.Temperature, StringFormat={}{0:F1}}"/>
                        <Run Text="℃" FontSize="14"/>
                    </TextBlock>

                    <!-- 实时曲线迷你图 -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        Margin="0,2,0,0"
                                        Background="Transparent"/>
                </Grid>

                <!-- 报警指示灯 -->
                <Ellipse Width="20" Height="20" 
                         HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="LightGreen"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Device.IsAlarming}" Value="True">
                                    <Setter Property="Fill" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>