<UserControl x:Class="MetalMonitor.UI.Views.DeviceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:MetalMonitor.UI.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="200">

    <!-- 根 Grid，命名为 RootGrid，后台代码会设置它的 DataContext -->
    <Grid x:Name="RootGrid" Cursor="Hand">
        <Border CornerRadius="8"
                Width="200" Padding="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FF2D2D3F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMetricAlarming}" Value="True">
                            <Setter Property="Background" Value="#FF4A3535"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- 设备名称 -->
                <TextBlock Text="{Binding Device.Name}"
                           FontSize="16" Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>
                <!-- 当前指标名 -->
                <TextBlock Text="{Binding MetricDisplayName}"
                           FontSize="11" Foreground="#FF9999AA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- 数值和曲线放在一起 -->
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="60"/> <!-- 曲线高度 -->
                    </Grid.RowDefinitions>

                    <!-- 指标数值 -->
                    <TextBlock Grid.Row="0" FontSize="28" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="LightGreen"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMetricAlarming}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMetricActive}" Value="False">
                                        <Setter Property="Foreground" Value="#FF777788"/>
                                    </DataTrigger>
                                    <!-- 质量码染色：数据陈旧→琥珀、不可信→灰；可信度提示优先于报警色 -->
                                    <DataTrigger Binding="{Binding CurrentMetricQuality}" Value="Stale">
                                        <Setter Property="Foreground" Value="#FFFFB86B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentMetricQuality}" Value="Bad">
                                        <Setter Property="Foreground" Value="#FF777788"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding ValueText, Mode=OneWay}"/>
                        <Run Text="{Binding CurrentUnit, Mode=OneWay}" FontSize="14"/>
                    </TextBlock>

                    <!-- 质量角标：与数值同行叠加右上角，Good 时隐藏 -->
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               FontSize="9" FontWeight="SemiBold" Padding="3,1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMetricQuality}" Value="Stale">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="陈旧"/>
                                        <Setter Property="Foreground" Value="#FFFFB86B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentMetricQuality}" Value="Bad">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="不可信"/>
                                        <Setter Property="Foreground" Value="#FF9999AA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 实时曲线迷你图 -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        Margin="0,2,0,0"
                                        Background="Transparent"/>
                </Grid>

                <!-- 状态指示灯 + 停用提示 -->
                <Grid Margin="0,5,0,0">
                    <Ellipse Width="20" Height="20"
                             HorizontalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="LightGreen"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMetricAlarming}" Value="True">
                                        <Setter Property="Fill" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMetricActive}" Value="False">
                                        <Setter Property="Fill" Value="#FF555566"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="已停用" FontSize="10" Foreground="#FF9999AA"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsMetricActive, Converter={x:Static vm:InverseBooleanToVisibilityConverter.Instance}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 设备暂停遮罩：IsPaused=true 时覆盖整个卡片，整体灰化并显示"暂停中"标识；
             IsHitTestVisible=False 使鼠标点击穿透，暂停状态下仍可点开详情窗口 -->
        <Border CornerRadius="8"
                Background="#CC1C1C28"
                IsHitTestVisible="False"
                Visibility="{Binding IsPaused, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="‖" FontSize="32" FontWeight="Bold"
                           Foreground="#FFB8B8C8" HorizontalAlignment="Center"/>
                <TextBlock Text="暂停中" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFD5D5E0" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
