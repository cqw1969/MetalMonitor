<Window x:Class="MetalMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MetalMonitor.UI.Views"
        Title="金属加工设备实时监控" Height="450" Width="650"
        Background="#FF1E1E2E">
    <Grid Margin="10">
        <!-- ItemsControl：循环绑定 Devices 集合 -->
        <ItemsControl ItemsSource="{Binding DeviceCardViewModels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 卡片横向排列，宽度不够自动换行 -->
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 使用我们封装好的 DeviceCardView 用户控件 -->
                    <views:DeviceCardView Margin="0,0,10,10"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>