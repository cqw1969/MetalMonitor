<Window x:Class="MetalMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MetalMonitor.UI"
        Title="金属加工设备实时监控" Height="250" Width="400"
        Background="#FF1E1E2E">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- 设备名称 -->
            <TextBlock Text="{Binding CurrentDevice.Name}" 
                       FontSize="24" Foreground="White" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- 温度显示，带单位 -->
            <TextBlock FontSize="48" Foreground="LightGreen" 
                       HorizontalAlignment="Center">
                <Run Text="{Binding CurrentDevice.Temperature, StringFormat='\{0:F1\}'}"/>
                <Run Text=" ℃" FontSize="24"/>
            </TextBlock>

            <!-- 状态指示灯 -->
            <Ellipse Width="30" Height="30" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="LightGreen"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentDevice.IsAlarming}" Value="True">
                                <Setter Property="Fill" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </StackPanel>
    </Grid>
</Window>