<Window x:Class="MetalMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MetalMonitor.UI.Views"
        xmlns:vm="clr-namespace:MetalMonitor.UI.ViewModels"
        Title="金属加工设备实时监控" Height="800" Width="1000"
        Background="#FF161622">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="#FF6CD46C" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="设备实时监控系统" FontSize="28" FontWeight="Bold" Foreground="#FFE0E0E0"/>
                    <TextBlock Text="v1.0" FontSize="14" Foreground="#FF666677" Margin="10,0,0,0"/>
                    <!-- 状态区：数据源状态（连接结果）与链路健康（是否真在送数）两行并列，正交不合并 -->
                    <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF6CD46C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataSourceState}" Value="Faulted">
                                            <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataSourceState}" Value="Unavailable">
                                            <Setter Property="Foreground" Value="#FF777788"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="数据源："/><Run Text="{Binding DataSourceStateText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF777788"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLinkHealth}" Value="Healthy">
                                            <Setter Property="Foreground" Value="#FF6CD46C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentLinkHealth}" Value="Recovering">
                                            <Setter Property="Foreground" Value="#FFFFB86B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentLinkHealth}" Value="NoValidFrame">
                                            <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentLinkHealth}" Value="NoSignal">
                                            <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="链路："/><Run Text="{Binding LinkHealthText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <Button Content="设备管理" Click="OnOpenDeviceManagement" Background="#FF6CD46C" Foreground="#FF161622" Padding="12,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="系统设置" Click="OnOpenSystemSettings" Background="#FFFFB86B" Foreground="#FF161622" Padding="12,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                    <Border CornerRadius="4" Background="#FF252533" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="监控指标：" FontSize="12" Foreground="#FF666677" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                      SelectedValue="{Binding SelectedMetricName, Mode=TwoWay}"
                                      SelectedValuePath="Name"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="12" FontWeight="SemiBold" MinWidth="100"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Background="#FF252533" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="数据来源：" FontSize="12" Foreground="#FF666677" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DataSourceOptions}"
                                      SelectedItem="{Binding SelectedDataSource, Mode=TwoWay}"
                                      FontSize="12" FontWeight="SemiBold" MinWidth="90"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Background="#FF252533" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="数据库：" FontSize="12" Foreground="#FF666677"/>
                            <TextBlock Text="{Binding DatabasePath}" FontSize="12" FontWeight="SemiBold" Foreground="#FF4A90D9" MaxWidth="200" ToolTip="{Binding DatabasePath}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="选择路径" Click="OnSelectDatabasePath" Background="#FF4A90D9" Foreground="White" Padding="8,4" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#FF161622">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DeviceCardViewModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:DeviceCardView Margin="0,0,15,15" CardClicked="OnDeviceCardClicked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF252533" Offset="0"/>
                        <GradientStop Color="#FF1E1E2C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="8" ShadowDepth="3"/>
                </Border.Effect>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Border Width="3" Height="20" Background="#FFFFB86B" CornerRadius="1.5" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                        <TextBlock Text=" 系统日志" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                    </Grid>
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding AlarmLogs}" 
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           FontSize="12" 
                                           Foreground="#FFAAAAAA"
                                           Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>