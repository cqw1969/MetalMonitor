<Window x:Class="MetalMonitor.UI.Windows.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置 - 指标与报警配置" Height="700" Width="900"
        Background="#FF161622" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="750" MinHeight="600">
    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D3F"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF3D3D4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FF6CD46C"/>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5BA0E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3D3D4F"/>
                                <Setter Property="Foreground" Value="#FF666677"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FFE05555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFF6B6B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3D3D4F"/>
                                <Setter Property="Foreground" Value="#FF666677"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Background" Value="#FF2D2D3F"/>
            <Setter Property="BorderBrush" Value="#FF3D3D4F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="28" Background="#FFFFB86B" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="指标与报警配置" FontSize="24" FontWeight="Bold" Foreground="#FFE0E0E0"/>
            </StackPanel>
        </Grid>

        <!-- 指标配置列表 -->
        <Border Grid.Row="1" CornerRadius="8" Background="#FF1E1E2E" Padding="2" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding MetricConfigs}"
                      SelectedItem="{Binding SelectedMetricConfig}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      RowBackground="#FF1E1E2E"
                      AlternatingRowBackground="#FF252533"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      SelectionMode="Single"
                      Foreground="#FFE0E0E0"
                      ColumnHeaderHeight="36">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF2D2D3F"/>
                        <Setter Property="Foreground" Value="#FFAAAAAA"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderBrush" Value="#FF3D3D4F"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderBrush" Value="#FF2D2D3F"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF3D3D5F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称(键)" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="100"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="报警阈值" Binding="{Binding AlarmThreshold, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridCheckBoxColumn Header="启用报警" Binding="{Binding AlarmEnabled}" Width="80"
                                            ElementStyle="{StaticResource DarkDataGridCheckBox}"
                                            EditingElementStyle="{StaticResource DarkDataGridCheckBox}"/>
                    <DataGridTextColumn Header="报警方向" Binding="{Binding AlarmDirection}" Width="90"/>
                    <DataGridTextColumn Header="最小值" Binding="{Binding MinValue, StringFormat={}{0:F1}}" Width="80"/>
                    <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue, StringFormat={}{0:F1}}" Width="80"/>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="50"
                                            ElementStyle="{StaticResource DarkDataGridCheckBox}"
                                            EditingElementStyle="{StaticResource DarkDataGridCheckBox}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 编辑表单 -->
        <Border Grid.Row="2" CornerRadius="8" Background="#FF1E1E2E" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：名称、显示名、单位 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="名称(键，唯一)" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="显示名" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="单位" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- 第二行：报警阈值、报警方向、启用报警 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="报警阈值" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditAlarmThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="报警方向" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AlarmDirectionOptions}"
                                  SelectedItem="{Binding EditAlarmDirection}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <CheckBox Content="启用报警" IsChecked="{Binding EditAlarmEnabled}" Style="{StaticResource DarkCheckBox}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 第三行：最小值、最大值、启用指标 -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="最小值(模拟数据下限)" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditMinValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="最大值(模拟数据上限)" FontSize="12" Foreground="#FF666677" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditMaxValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <CheckBox Content="启用指标" IsChecked="{Binding EditIsActive}" Style="{StaticResource DarkCheckBox}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 按钮行 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="添加指标" Style="{StaticResource DarkButton}" Click="OnAddMetric" Margin="0,0,10,0"/>
                    <Button Content="修改指标" Style="{StaticResource DarkButton}" Click="OnUpdateMetric" Margin="0,0,10,0"/>
                    <Button Content="删除指标" Style="{StaticResource DangerButton}" Click="OnDeleteMetric"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="3">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#FF6CD46C" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
