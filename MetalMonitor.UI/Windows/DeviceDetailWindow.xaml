<Window x:Class="MetalMonitor.UI.Windows.DeviceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:MetalMonitor.UI.ViewModels"
        xmlns:core="clr-namespace:MetalMonitor.Core;assembly=MetalMonitor.core"
        Title="设备详情" Height="700" Width="900"
        Background="#FF161622" WindowStartupLocation="CenterOwner">
    <Grid Background="#FF1E1E2E">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8" Background="#FF2D2D3F" Padding="15" Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Device.Name}" FontSize="24" Foreground="White" Margin="0,0,20,0"/>
                    <TextBlock FontSize="20" Foreground="LightGreen">
                        <Run Text="{Binding Device.Temperature, StringFormat={}{0:F1}}"/>
                        <Run Text="℃" FontSize="14"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" Grid.RowSpan="2" Background="#FF1E1E2E">
                <TabItem Header="实时监控">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="8" Background="#FF2D2D3F" Padding="15" Grid.Row="0" Margin="0,0,0,10">
                            <WrapPanel HorizontalAlignment="Center">
                                <TextBlock Text="指标类型:" FontSize="14" Foreground="LightGray" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                          SelectedValue="{Binding SelectedMetricName}"
                                          SelectedValuePath="Name"
                                          DisplayMemberPath="DisplayName"
                                          Width="120" Margin="0,0,20,0"/>
                            </WrapPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#FF2D2D3F" Padding="15" Grid.Row="1">
                            <lvc:CartesianChart Series="{Binding Series}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                Background="Transparent"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="历史数据">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="8" Background="#FF2D2D3F" Padding="15" Grid.Row="0" Margin="0,0,0,10">
                            <WrapPanel HorizontalAlignment="Center">
                                <TextBlock Text="开始日期:" FontSize="14" Foreground="LightGray" Margin="0,0,5,0"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Width="150" Margin="0,0,20,0"/>

                                <TextBlock Text="→" FontSize="18" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <TextBlock Text="结束日期:" FontSize="14" Foreground="LightGray" Margin="0,0,5,0"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Width="150" Margin="0,0,20,0"/>

                                <TextBlock Text="指标类型:" FontSize="14" Foreground="LightGray" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                          SelectedValue="{Binding SelectedMetricName}"
                                          SelectedValuePath="Name"
                                          DisplayMemberPath="DisplayName"
                                          Width="120" Margin="0,0,20,0"/>

                                <Button Content="查询" Click="OnQueryButtonClick" 
                                        Background="#FF4A90D9" Foreground="White" 
                                        BorderBrush="Transparent"
                                        Padding="15,5,15,5" FontSize="14"/>
                            </WrapPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#FF2D2D3F" Padding="15" Grid.Row="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <lvc:CartesianChart Series="{Binding Series}"
                                                    XAxes="{Binding XAxes}"
                                                    YAxes="{Binding YAxes}"
                                                    Background="Transparent" Grid.Row="0"/>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                        <TextBlock Text="历史记录" FontSize="16" Foreground="White"/>
                                        <TextBlock Text=" (" FontSize="14" Foreground="LightGray"/>
                                        <TextBlock Text="{Binding HistoricalRecords.Count}" FontSize="14" Foreground="LightGreen"/>
                                        <TextBlock Text=" 条)" FontSize="14" Foreground="LightGray"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding HistoricalRecords}" Grid.Row="1"
                                              AutoGenerateColumns="False" HeadersVisibility="Column"
                                              Background="#FF1E1E2E" Foreground="White"
                                              BorderBrush="#FF555566" RowBackground="#FF2D2D3F"
                                              AlternatingRowBackground="#FF3D3D4F" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180"/>
                                            <DataGridTextColumn Header="指标" Binding="{Binding MetricName}" Width="100"/>
                                            <DataGridTextColumn Header="数值" Width="100">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0:F2} {1}">
                                                        <Binding Path="Value"/>
                                                        <Binding Path="Unit"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding IsLoading, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <Rectangle Fill="Black" Opacity="0.5"/>
                <TextBlock Text="加载中..." FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
